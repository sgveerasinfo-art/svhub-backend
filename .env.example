PORT=5000
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Production frontend origins are also allowlisted in src/app.js:
# https://svhub.shop , https://www.svhub.shop
DB_USERNAME=
DB_PASSWORD=
MONGO_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@svhub.hjrmqta.mongodb.net/?retryWrites=true&w=majority&appName=svhub
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@svhub.hjrmqta.mongodb.net/?retryWrites=true&w=majority&appName=svhub
MONGO_DB=svhub
JWT_SECRET=change-me

# Project ID is enough to verify Google ID tokens.
# Optional Admin SDK service account (not required for local Google Sign-In):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional outbound email (password reset + admin invitations)
# Without these, Super Admins receive a one-time setup URL in the Manage Access UI
# after creating/resending an invitation (never logged; not returned on public APIs).
# EMAIL_FROM=noreply@svhub.shop
# SMTP_URL=
# RESEND_API_KEY=
# EMAIL_PROVIDER=console

