PORT=5000
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Production frontend origins are also allowlisted in src/app.js:
# https://svhub.shop , https://www.svhub.shop
DB_USERNAME=
DB_PASSWORD=
MONGO_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@svhub.hjrmqta.mongodb.net/?retryWrites=true&w=majority&appName=svhub
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@svhub.hjrmqta.mongodb.net/?retryWrites=true&w=majority&appName=svhub
MONGO_DB=svhub
JWT_SECRET=change-me

# Project ID is enough to verify Google ID tokens.
# Optional Admin SDK service account (not required for local Google Sign-In):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional outbound email (password reset + admin invitations)
# Production: set RESEND_API_KEY (preferred) or SMTP_URL.
# Also set EMAIL_FROM and CLIENT_URL=https://www.svhub.shop
# Without these, forgot-password returns emailDeliveryConfigured:false
# EMAIL_FROM=SV Hub <noreply@svhub.shop>
# SUPPORT_EMAIL=sgveeras.info@gmail.com
# RESEND_API_KEY=
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_PROVIDER=console
